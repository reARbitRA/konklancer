# --- هوش مصنوعی (SPEC-008) ---
# راه اصلی: از داخل برنامه «تنظیمات → هوش مصنوعی» یک provider و کلید اضافه کنید.
# کلیدها در data/ai-config.json (مجوز 600، gitignored) ذخیره می‌شوند و به مرورگر برنمی‌گردند.
# اگر می‌خواهید فایل تنظیمات جای دیگری باشد:
# KONKLANCER_AI_CONFIG_FILE="/absolute/path/ai-config.json"
#
# جایگزین اختیاری: کلید مستقیم providerها از محیط (فقط برای dev؛ در UI نمایش داده می‌شود).
# OPENAI_API_KEY=""
# OPENROUTER_API_KEY=""
# GROQ_API_KEY=""
# GEMINI_API_KEY=""
# DEEPSEEK_API_KEY=""
# MISTRAL_API_KEY=""
# CEREBRAS_API_KEY=""
# TOGETHER_API_KEY=""
# OLLAMA_BASE_URL="http://localhost:11434/v1"
#
# --- Konkred gateway (SPEC-006): اختیاری، برای کسانی که گیت‌وی را جدا اجرا می‌کنند ---
# Base URL of the running konkred gateway (gateway/ in reARbitRA/konkred-AI-ecosystem).
KONKRED_GATEWAY_URL="http://localhost:4000"
# One of the USERS_JSON keys configured on the gateway.
KONKRED_API_KEY="MY_KONKRED_KEY"
# Optional. Default "any" (decision D2 in SPEC-006). Use "private" to exclude providers that train on data.
KONKRED_PRIVACY="any"
# Optional. Timeout per gateway call in ms (default 60000) and analysis cache TTL in hours (default 168).
KONKRED_TIMEOUT_MS="60000"
KONKRED_CACHE_TTL_HOURS="168"

# --- اسکنر فقط‌خواندنی (SPEC-004) — برای استفاده‌ی شخصی ---
# چه چیزی اسکن شود؟ پلتفرم‌ها باید با
# `python -m scanner.konklancer_scan enable --platform <id>` فعال شوند.
# پلتفرمی که انتخابگر CSS ندارد هم کار می‌کند: ساختار صفحه در زمان اسکن خودکار کشف می‌شود.
KONKLANCER_SCAN_PLATFORMS=""
# اگر 1 باشد، کانال‌های تلگرامی که scan_enabled=true دارند اسکن می‌شوند.
KONKLANCER_SCAN_TELEGRAM="0"
# فیلتر کلیدواژه (اختیاری). خالی = بدون فیلتر ⇒ همه‌ی دسته‌ها اسکن می‌شوند
# (ترجمه، طراحی، گرافیک، بروشور، ویدیو، صدا، محتوا، داده، کد و ...).
KONKLANCER_SCAN_INCLUDE=""
KONKLANCER_SCAN_EXCLUDE=""
# محدودکردن به دسته‌های مشخص (اختیاری). خالی = همه‌ی دسته‌ها.
# کلیدها از shared/taxonomy.json: translation, graphic, video, audio, image, docs, writing,
# marketing, data, uiux, automation, dev. مثال: translation,graphic
KONKLANCER_SCAN_CATEGORIES=""
# کشف خودکار ساختار صفحه در زمان اسکن (پیش‌فرض: 1). برای اسکن فقط با انتخابگرهای ذخیره‌شده 0 بگذارید.
KONKLANCER_SCAN_AUTO="1"
KONKLANCER_SCAN_PAGES="1"
KONKLANCER_SCAN_DELAY="8"
# فقط پروژه‌های با امتیاز >= این مقدار وارد فید شوند (SPEC-004 R5). 0 = همه.
KONKLANCER_SCAN_MIN_SCORE="0"
# اسکن خودکار دوره‌ای به دقیقه. 0 = خاموش.
KONKLANCER_SCAN_INTERVAL_MIN="0"
# مفسر پایتون (اگر در venv نصب کرده‌اید، مسیر آن را بدهید).
KONKLANCER_PYTHON="python3"

# --- فید ابری: اجرای همان اسکنر روی رانرهای گیت‌هاب (SPEC-004/007) ---
# چرا: بعضی محیط‌ها (سندباکس/مرورگر/شبکه‌ی محدود) به سایت‌های فریلنسری دسترسی TCP ندارند.
# ورک‌فلوی .github/workflows/scanner-feed.yml اسکنر واقعی را روی رانر گیت‌هاب اجرا می‌کند،
# فید را در scanner/cloud-feed.jsonl می‌گذارد و سرور با GitHub API آن را می‌خواند.
# خالی بگذارید تا این قابلیت خاموش بماند و فقط اسکن محلی استفاده شود.
KONKLANCER_CLOUD_FEED_REPO=""
# برنچی که ورک‌فلو و فید روی آن هستند (مثلاً arena/bb8cb4b4-konklancer یا main)
KONKLANCER_CLOUD_FEED_REF="main"
# توکن برای درخواست اسکن و خواندن فید مخزن خصوصی. اگر خالی باشد از `gh auth token` استفاده می‌شود.
KONKLANCER_CLOUD_TOKEN=""
# حداکثر مدت انتظار برای پایان اسکن ابری (میلی‌ثانیه)
KONKLANCER_CLOUD_POLL_MS="300000"

# --- Other ---
PORT="3000"
# Set to 1 to show fabricated demo jobs in the feed (SPEC-004 R1). Default off.
KONKLANCER_DEMO="0"
